FROM containers.mathworks.com/matlab-runtime:r2025b

USER root

# Install Python 3.12 and pip
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        python3 \
        python3-pip \
        python3-venv \
    && rm -rf /var/lib/apt/lists/*

ENV PYTHONUNBUFFERED=1 \
    PYTHONIOENCODING=UTF-8 \
    PYTHONPATH="/app"

WORKDIR /app

# Copy and install Python dependencies + the MATLAB wheel
COPY benchmark-matlab/requirements.txt .
COPY benchmark-matlab/quixmatlab_r2025b-25.2-py3-none-any.whl .
RUN pip install --no-cache-dir --break-system-packages \
    -r requirements.txt \
    quixmatlab_r2025b-25.2-py3-none-any.whl

# Copy the full repo (so FMU files are available)
COPY . /app

WORKDIR /app/benchmark-matlab

ENTRYPOINT ["python3", "main.py"]
